 "exercises": [
  {
   "type": "mc",
   "q": "Qual palavra significa \"dela\"?",
   "options": [
    "zijn",
    "hun",
    "haar",
    "ons"
   ],
   "answer": 2,
   "explain": "haar = dela. zijn = dele, hun = deles/delas, ons = nosso."
  },
  {
   "type": "mc",
   "q": "Como se diz \"nossa casa\" (het huis)?",
   "options": [
    "onze huis",
    "ons huis",
    "ons huize",
    "onze huizen"
   ],
   "answer": 1,
   "explain": "huis é het-woord no singular, então ons. Onze só aparece com de-woorden (onze kamer) e com plurais (onze huizen)."
  },
  {
   "type": "mc",
   "q": "Qual é o diminutivo de \"de man\"?",
   "options": [
    "het manje",
    "het mantje",
    "de mannetje",
    "het mannetje"
   ],
   "answer": 3,
   "explain": "Depois de vogal curta + consoante, dobra-se a consoante e entra -etje: man, mannetje. E o artigo vira het."
  },
  {
   "type": "mc",
   "q": "O que acontece com o artigo quando se faz um diminutivo com -je?",
   "options": [
    "Nada, continua de",
    "Vira sempre het",
    "Vira een",
    "Desaparece"
   ],
   "answer": 1,
   "explain": "Todo diminutivo é het-woord: de man, het mannetje; de koffie, het koffietje."
  },
  {
   "type": "mc",
   "q": "Qual é o diminutivo de \"de bloem\" (a flor)?",
